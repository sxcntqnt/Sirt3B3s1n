# =============================================================================
# Matatu Pulse — GPS Pipeline .env.example
# Copy to .env.dev (development) or .env.prod (production) and fill in values.
# NEVER commit a file containing real secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Orchestrator
# -----------------------------------------------------------------------------

# Directory containing compiled service binaries (ignored when USE_GO_RUN=true)
BINARY_DIR=./bin

# Set to true to use `go run ./service-dir` instead of pre-built binaries.
# ONLY for development — introduces significant startup latency per replica.
USE_GO_RUN=false

# Listen address for the orchestrator control-plane HTTP API.
# Exposes: GET /health  GET /status  POST /scale  GET /metrics
CONTROL_PLANE_ADDR=:7070

# How often the auto-scaler samples Redis stream lag and adjusts replica counts.
SCALE_INTERVAL=15s

# How often each replica's /health endpoint is polled.
HEALTH_CHECK_INTERVAL=10s

# Per-poll HTTP timeout for health checks.
HEALTH_CHECK_TIMEOUT=3s

# Consecutive health failures before a replica is considered dead and restarted.
UNHEALTHY_THRESHOLD=3

# Maximum exponential back-off between process restart attempts.
RESTART_BACKOFF_MAX=1m

# -----------------------------------------------------------------------------
# Auto-scaler thresholds (mqtt-consumer pool)
#
# Redis batch stream lag (number of messages) that controls mqtt-consumer scaling.
# At 100K vehicles / 20K events/sec:
#   SCALE_UP_LAG=50000   → ~2.5 s of buffered events  (consumers falling behind)
#   SCALE_DOWN_LAG=5000  → ~0.25 s of buffered events (comfortable headroom)
# Tighten these values for lower-latency environments.
# -----------------------------------------------------------------------------
SCALE_UP_LAG=50000
SCALE_DOWN_LAG=5000

# -----------------------------------------------------------------------------
# mqtt-consumer pool
# -----------------------------------------------------------------------------

MQTT_CONSUMER_MIN=4
MQTT_CONSUMER_MAX=32

# Base port for per-replica metrics endpoints.
# Replica N binds to MQTT_CONSUMER_METRICS_BASE_PORT + N  (e.g. 9100, 9101 …)
MQTT_CONSUMER_METRICS_BASE_PORT=9100

# Base port for per-replica health endpoints.
# Replica N binds to MQTT_CONSUMER_HEALTH_BASE_PORT + N   (e.g. 8100, 8101 …)
MQTT_CONSUMER_HEALTH_BASE_PORT=8100

# -----------------------------------------------------------------------------
# batch-writer pool
# -----------------------------------------------------------------------------

BATCH_WRITER_MIN=2
BATCH_WRITER_MAX=8

# Replica N → 9200 + N
BATCH_WRITER_METRICS_BASE_PORT=9200
# Replica N → 8200 + N
BATCH_WRITER_HEALTH_BASE_PORT=8200

# -----------------------------------------------------------------------------
# websocket-gateway pool
# -----------------------------------------------------------------------------

WS_GATEWAY_MIN=2
WS_GATEWAY_MAX=10

# Replica N → 9300 + N
WS_GATEWAY_METRICS_BASE_PORT=9300
# Replica N → 8300 + N
WS_GATEWAY_HEALTH_BASE_PORT=8300

# =============================================================================
# Shared infrastructure secrets
# These are injected into every service replica by the orchestrator.
# =============================================================================

# -----------------------------------------------------------------------------
# MQTT broker
# Format: host:port  (no scheme)
# -----------------------------------------------------------------------------
MQTT_BROKER=mosquitto.service.consul:1883
MQTT_USERNAME=mqtt-consumer
MQTT_PASSWORD=change-me

# -----------------------------------------------------------------------------
# Redis Cluster
# The orchestrator hard-codes the three node addresses in each service's config.
# Only the password needs to be supplied here.
# -----------------------------------------------------------------------------
REDIS_PASSWORD=change-me

# -----------------------------------------------------------------------------
# ClickHouse
# Format for host: host:port  (native TCP port, default 9000; or HTTP port 8123)
# -----------------------------------------------------------------------------
CLICKHOUSE_HOST=clickhouse.service.consul:9000
CLICKHOUSE_USERNAME=batch_writer
CLICKHOUSE_PASSWORD=change-me

# -----------------------------------------------------------------------------
# Auth microservice (Go auth service with Dgraph)
# Used by websocket-gateway to validate JWT claims on WebSocket upgrade.
# -----------------------------------------------------------------------------
AUTH_SERVICE_URL=http://auth-service.service.consul:8090

# JWT signing secret — must match the auth microservice configuration.
# Minimum 32 random bytes, base64 or hex encoded.
JWT_SECRET=change-me-minimum-32-bytes-random

# -----------------------------------------------------------------------------
# Jaeger distributed tracing
# Set to empty string to disable tracing (sampler will still initialise but
# the exporter will be a no-op).
# -----------------------------------------------------------------------------
JAEGER_ENDPOINT=http://jaeger-collector.service.consul:14268/api/traces

# =============================================================================
# Per-service runtime knobs (optional overrides)
# The values below are the compiled-in defaults. Uncomment to override.
# =============================================================================

# --- mqtt-consumer -----------------------------------------------------------

# Worker goroutines per replica (each processes one MQTT message at a time).
# 8 workers × 32 max replicas = 256 concurrent processors at peak.
# MQTT_CONSUMER_WORKERS=8

# Inbound channel buffer depth. If all workers are busy, MQTT messages queue
# here before backpressure kicks in.
# MQTT_CONSUMER_BUFFER_SIZE=10000

# Movement filter: minimum displacement (metres) before an event is forwarded
# to the realtime stream. Events below this threshold still go to the batch
# stream for persistence.
# MQTT_CONSUMER_MIN_DISTANCE_M=20

# Movement filter: minimum seconds between successive broadcasts for the same
# vehicle regardless of distance.
# MQTT_CONSUMER_MIN_TIME_S=5

# Backpressure: Redis XADD wall-clock latency (milliseconds) above which events
# are diverted to the local in-memory ring buffer instead of Redis.
# MQTT_CONSUMER_BP_MAX_LATENCY_MS=50

# Backpressure: capacity of the local ring buffer. Normal events are evicted
# first (hot-path-first) when the buffer is full; critical events are retained.
# MQTT_CONSUMER_BP_BUFFER_SIZE=10000

# --- batch-writer ------------------------------------------------------------

# Number of parallel ClickHouse INSERT goroutines per replica.
# BATCH_WRITER_PARALLEL_WRITES=4

# Maximum rows per INSERT batch.
# BATCH_WRITER_MAX_BATCH_ROWS=10000

# Maximum wall-clock interval between ClickHouse flushes even if the batch
# is not yet full.
# BATCH_WRITER_FLUSH_INTERVAL=5s

# ClickHouse block compression codec.
# BATCH_WRITER_COMPRESSION=lz4

# Dead-letter queue: maximum retry attempts before an event is discarded.
# BATCH_WRITER_DLQ_MAX_RETRIES=3

# Dead-letter queue: interval between retry passes.
# BATCH_WRITER_DLQ_RETRY_INTERVAL=60s

# --- websocket-gateway -------------------------------------------------------

# Maximum simultaneous WebSocket connections per replica.
# WS_GATEWAY_MAX_CONNECTIONS=10000

# Maximum subscribed vehicles per connection.
# WS_GATEWAY_MAX_SUBSCRIPTIONS=1000

# WebSocket ping interval. Clients that do not respond within
# WS_GATEWAY_PING_TIMEOUT are disconnected.
# WS_GATEWAY_PING_INTERVAL=30s
# WS_GATEWAY_PING_TIMEOUT=10s

# Per-IP connection rate limit.
# WS_GATEWAY_MAX_CONNECTIONS_PER_IP=100

# =============================================================================
# Development overrides
# Copy this block into your .env.dev and uncomment.
# =============================================================================

# USE_GO_RUN=true
# BINARY_DIR=.

# MQTT_BROKER=localhost:1883
# MQTT_USERNAME=dev
# MQTT_PASSWORD=devpassword

# REDIS_PASSWORD=devpassword

# CLICKHOUSE_HOST=localhost:9000
# CLICKHOUSE_USERNAME=dev
# CLICKHOUSE_PASSWORD=devpassword

# AUTH_SERVICE_URL=http://localhost:8090
# JWT_SECRET=dev-jwt-secret-not-for-production

# JAEGER_ENDPOINT=http://localhost:14268/api/traces

# Smaller pools for local development
# MQTT_CONSUMER_MIN=1
# MQTT_CONSUMER_MAX=2
# BATCH_WRITER_MIN=1
# BATCH_WRITER_MAX=1
# WS_GATEWAY_MIN=1
# WS_GATEWAY_MAX=2

# Lower thresholds so the scaler reacts faster on a single machine
# SCALE_UP_LAG=500
# SCALE_DOWN_LAG=50
# SCALE_INTERVAL=5s
